RC_DATABASE_URL=sqlite:///./repaircalc_local.sqlite
RC_CATALOG_YML_URL=https://fidsout.maxidom.ru/fids/export_yandex_spb.xml
RC_CATALOG_PATH=data/catalog.json

RC_OLLAMA_URL=http://localhost:11434
RC_LLM_MODEL=qwen2.5:3b
RC_EMBED_MODEL=bge-m3

# RC_ENGINE_IMPL=app.engine.rules:RulesEngine
# RC_CLASSIFIER_IMPL=app.ml.matcher:EmbeddingClassifier
# The trained classifier and this trusted local artifact are the defaults.
# RC_ML_CLASSIFIER_BACKEND=trained
# RC_AUTOBIND_MIN_CONFIDENCE=0.7
# RC_RANKER_IMPL=app.ml.ranker:ContextRanker


# Anonymous consultant sessions. Use a long random secret and secure cookies in HTTPS production.
RC_CONSULTANT_SESSION_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET
RC_CONSULTANT_COOKIE_SECURE=false


RC_ML_CLASSIFIER_ARTIFACT_PATH=ml_workspace/model/tfidf_logreg

# Для использования консультанта:
# 1. Скопируйте .env.example в .env
# 2. Раскомментируйте настройки ниже
# 3. Вставьте свои GigaChat API credentials
# 4. Проверьте наличие файла сертификата
# 5. Перезапустите backend
#
# Не добавляйте настоящий .env в Git!

# RC_GIGACHAT_ENABLED=true
# RC_GIGACHAT_CREDENTIALS=YOUR_GIGACHAT_CREDENTIALS
# RC_GIGACHAT_SCOPE=GIGACHAT_API_PERS
# RC_GIGACHAT_MODEL=GigaChat-2
# RC_GIGACHAT_TOKEN_BUDGET=50000
# RC_GIGACHAT_EXPLANATIONS=false
# RC_GIGACHAT_VERIFY_SSL=true
# RC_GIGACHAT_CA_BUNDLE=certs/gigachat_ca_bundle.pem